<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file; cloud-backup and device-to-device transfer
   rules can be customized here.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>