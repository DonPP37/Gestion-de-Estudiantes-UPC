<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvTituloNotif"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Título de la Notificación"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvFechaNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01/01/2026 12:00"
                android:textSize="12sp"
                android:textColor="#888888" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMensajeNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este es el mensaje detallado de la notificación recibida en la plataforma UPC."
            android:textSize="14sp"
            android:textColor="#555555" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
