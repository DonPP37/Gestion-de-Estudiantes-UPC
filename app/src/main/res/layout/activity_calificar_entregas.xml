<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Encabezado de la actividad evaluada -->
    <TextView
        android:id="@+id/tvTituloActividadEntregas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entregas de Actividad"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1976D2"/>

    <TextView
        android:id="@+id/tvResumenEntregas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total de entregas: 0 | Calificadas: 0 | Pendientes: 0"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEntregasActividad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>
