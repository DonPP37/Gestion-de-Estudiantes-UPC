<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ===== SECCIÓN SUPERIOR DE ACCESOS RÁPIDOS POR ROL ===== -->
        <LinearLayout
            android:id="@+id/layout_accesos_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opciones del Sistema"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#3F51B5"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnAdminUsuarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Gestionar usuarios y roles" />

            <Button
                android:id="@+id/btnCrearCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Crear curso" />

            <Button
                android:id="@+id/btnAdminVerCursos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:backgroundTint="#FF9800"
                android:text="Ver Todos los Cursos (Admin)" />
        </LinearLayout>

        <!-- ===== HU-08: PANEL DE CURSOS MATRICULADOS PARA EL ESTUDIANTE ===== -->
        <LinearLayout
            android:id="@+id/layout_cursos_estudiante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E8EAF6"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mis Cursos Activos (HU-08)"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#1A237E"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_lista_cursos_vacia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No estás matriculado en ningún curso actualmente."
                android:textSize="14sp"
                android:textColor="#5C6BC0"
                android:fontStyle="italic"/>

            <TextView
                android:id="@+id/tv_cursos_matriculados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#212121"
                android:lineSpacingExtra="4dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"/>

            <Button
                android:id="@+id/btn_ir_a_matricularme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inscribirme en un curso"
                android:layout_marginTop="12dp"
                android:backgroundTint="#1A237E"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/btn_estudiante_ver_aulas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entrar a mis Aulas Virtuales"
                android:layout_marginTop="8dp"
                android:backgroundTint="#3F51B5"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi Perfil"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ===== FOTO ===== -->
        <ImageView
            android:id="@+id/ivFotoPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:background="#EEEEEE"
            android:contentDescription="Foto de perfil"
            android:src="@drawable/ic_perfil_placeholder" />

        <Button
            android:id="@+id/btnCambiarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Cambiar foto" />

        <!-- ===== DATOS ACADÉMICOS (SOLO LECTURA) ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Datos académicos"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Solo el administrador puede modificarlos."
            android:textSize="12sp"
            android:textColor="#757575" />

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvDocumento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvPrograma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- ===== DATOS DE CONTACTO (EDITABLES) ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Datos de contacto"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teléfono"
            android:inputType="phone"
            android:maxLength="15" />

        <Button
            android:id="@+id/btnGuardarContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Guardar cambios" />

        <!-- ===== CONTRASEÑA ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Cambiar contraseña"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mínimo 8 caracteres, una mayúscula y un número."
            android:textSize="12sp"
            android:textColor="#757575" />

        <EditText
            android:id="@+id/etPasswordActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña actual"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/etPasswordNueva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nueva contraseña"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/etPasswordConfirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirmar nueva contraseña"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnCambiarPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Actualizar contraseña" />

        <!-- ===== TRAZABILIDAD ===== -->
        <TextView
            android:id="@+id/tvUltimaActualizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="13sp"
            android:textColor="#757575"
            android:text="Sin cambios registrados" />

        <Button
            android:id="@+id/btnHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ver historial de cambios" />

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="Cerrar sesión" />
    </LinearLayout>
</ScrollView>
