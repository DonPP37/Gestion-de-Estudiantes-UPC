<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F5F5F5">

        <TextView
            android:id="@+id/tvBienvenidaInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Panel de Inicio"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvRolInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulta tus cursos y el calendario interactivo de actividades."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp"/>

        <!-- Botones Principales de Acceso a Cursos (Arriba del Calendario) -->
        <Button
            android:id="@+id/btnDocentePublicar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis Cursos Asignados (Entrar / Gestionar)"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnAccionRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acción"
            android:layout_marginBottom="12dp"/>

        <!-- Calendario Interactivo -->
        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:elevation="2dp"/>

        <TextView
            android:id="@+id/tvTituloActividadesFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actividades para la fecha seleccionada:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#1976D2"
            android:layout_marginBottom="8dp"/>

        <!-- Filtros de Calendario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Spinner
                android:id="@+id/spinnerFiltroCurso"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"/>

            <CheckBox
                android:id="@+id/chkOcultarEntregadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ocultar entregadas"
                android:textSize="12sp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerInicioCursos"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="12dp"/>

        <!-- Botones adicionales -->
        <Button
            android:id="@+id/btnBuscarInscribirCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buscar e Inscribirme a un Curso"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnEntregarTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entregar Tarea / Trabajo"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnMisActividades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis Actividades Pendientes"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnMisCalificaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis Calificaciones y Promedio"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
