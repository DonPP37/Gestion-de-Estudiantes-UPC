<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Fila superior: Estudiante y Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvEntregaEstudiante"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre del Estudiante (Código)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/tvEntregaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="entregada"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="#E0E0E0"
                android:textColor="#424242"/>
        </LinearLayout>

        <!-- Fecha y comprobante -->
        <TextView
            android:id="@+id/tvEntregaFechaYComprobante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entregado el: 13/10/2026 19:30 • Comprobante: REC-..."
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp"/>

        <!-- Texto / Descripción de entrega -->
        <TextView
            android:id="@+id/tvEntregaTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comentario o trabajo en texto..."
            android:textSize="13sp"
            android:textColor="#333333"
            android:layout_marginTop="6dp"/>

        <!-- Archivos adjuntos -->
        <TextView
            android:id="@+id/tvEntregaArchivos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📎 Archivos adjuntos: tarea.pdf (1.2 MB)"
            android:textSize="12sp"
            android:textColor="#1976D2"
            android:layout_marginTop="4dp"/>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginVertical="8dp"/>

        <!-- Sección de Calificación -->
        <LinearLayout
            android:id="@+id/layoutCalificacionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEntregaNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nota: 4.5 / 5.0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"/>

            <TextView
                android:id="@+id/tvEntregaFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retroalimentación: Excelente trabajo y entrega a tiempo."
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvEntregaHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Última modificación: 13/10/2026 por Prof. Carlos"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Botón de acción para el docente -->
        <Button
            android:id="@+id/btnCalificarEntrega"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Calificar / Retroalimentar"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
